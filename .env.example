# Required for every HTTP endpoint. Use the same value in the frontend .env.local.
# Browser login: username bazi, password APP_ACCESS_KEY. Generate at least 32 random characters.
APP_ACCESS_KEY=
# Without a model API key, the application returns an offline source directory.
ENVIRONMENT=development
LOG_LEVEL=INFO
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=90
EMBEDDING_TIMEOUT_SECONDS=60
HTTP_CONNECT_RETRIES=2
HTTP_REQUEST_RETRIES=2

# BGE-M3 runs locally. Set hash only as a dependency-free emergency fallback.
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_DEVICE=cpu
LOCAL_EMBEDDING_BATCH_SIZE=2
LOCAL_EMBEDDING_MAX_SEQ_LENGTH=512
LOCAL_EMBEDDING_WINDOW_OVERLAP=64
LOCAL_EMBEDDING_CACHE_BATCH_SIZE=8
# Build missing vectors explicitly with scripts/prewarm_retrieval.py.
BUILD_EMBEDDINGS_ON_STARTUP=false
REMOTE_EMBEDDING_MODEL=

# memory requires no extra service. Install requirements-retrieval.txt before qdrant.
VECTOR_BACKEND=memory
QDRANT_PATH=./data/qdrant
QDRANT_URL=
QDRANT_API_KEY=

RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=2
RERANKER_MAX_LENGTH=512
# Set true after the first download to prevent startup network checks.
LOCAL_MODELS_ONLY=false
EMBEDDING_CACHE_PATH=./data/embedding-cache.sqlite3

# Retrieval experiment knobs. Keep weights between 0 and 1 unless noted otherwise.
DENSE_RECALL_LIMIT=30
SPARSE_RECALL_LIMIT=30
RERANK_LIMIT=20
RESULT_LIMIT=6
RETRIEVAL_RRF_K=60
BM25_K1=1.2
BM25_B=0.75
BM25_HEADING_BOOST=50
BM25_TOPIC_BOOST=12
EXACT_TITLE_BOOST=0.5
CHAPTER_HEADING_BOOST=0.4
CHAPTER_TOPIC_BOOST=0.12
RERANK_FUSED_WEIGHT=0.35
RERANK_MODEL_WEIGHT=0.65
GRAPH_BOOST_PER_MATCH=0.006
GRAPH_BOOST_MAX=0.018
CONCEPT_BOOST_PER_MATCH=0.006
CONCEPT_BOOST_MAX=0.02
EVIDENCE_CHAIN_SCORE_RATIO=0.98

# Optional phase-three comparison backend. Point this at a LightRAG Server.
LIGHTRAG_BASE_URL=
LIGHTRAG_API_KEY=

DATABASE_PATH=./data/app.db
DATABASE_BUSY_TIMEOUT_MS=5000
KNOWLEDGE_PATH=./knowledge
EVALS_PATH=./evals
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=false

# Required to access /api/v1/observability/*; when empty those endpoints return 404.
OBSERVABILITY_API_KEY=
FEEDBACK_RATE_LIMIT_PER_MINUTE=10
FEEDBACK_CLIENT_RATE_LIMIT_PER_MINUTE=30

# Optional trusted same-origin proxy identity. Configure both or neither.
INTERNAL_PROXY_SECRET=
TRUSTED_PROXY_CIDRS=[]

# Compatibility routes emit Deprecation/Sunset headers and can be disabled after migration.
LEGACY_API_ENABLED=true
LEGACY_API_SUNSET="Thu, 01 Oct 2026 00:00:00 GMT"
