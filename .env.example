# The application runs without an API key and returns an extractive demo answer.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# hash is dependency-free and suitable for the included seed corpus.
# Use sentence_transformer after installing requirements-local-ml.txt.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
REMOTE_EMBEDDING_MODEL=

# memory requires no extra service. Install requirements-retrieval.txt before qdrant.
VECTOR_BACKEND=memory
QDRANT_PATH=./data/qdrant

# Enable after installing the local-ml optional dependency.
RERANKER_PROVIDER=lexical
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Optional phase-three comparison backend. Point this at a LightRAG Server.
LIGHTRAG_BASE_URL=
LIGHTRAG_API_KEY=

DATABASE_PATH=./data/app.db
KNOWLEDGE_PATH=./knowledge
EVALS_PATH=./evals
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
